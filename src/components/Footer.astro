---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/services', label: 'Services' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/contact', label: 'Contact' },
];

const services = [
  'Web Development',
  'SEO Optimization',
  'Social Media Marketing',
  'AI Video Creation',
  'Digital Marketing',
  'Mobile App Development',
];

const locations = [
  'Tech City', 'Indore', 'Jabalpur', 'Gwalior', 'Pan-India',
];
---

<footer class="qf-footer">
  <div class="qf-footer__glow"></div>
  <div class="qf-container">
    <!-- Top Section -->
    <div class="qf-footer__top">
      <div class="qf-footer__brand">
        <a href="/" class="qf-footer__logo">
          <span class="qf-footer__logo-icon">Q</span>
          <span class="qf-footer__logo-text">Quantum<span class="qf-footer__logo-accent">Frame</span></span>
        </a>
        <p class="qf-footer__tagline">
          Transforming businesses through cutting-edge web development, digital marketing, and AI-powered solutions. Your growth is our mission.
        </p>
        <div class="qf-footer__social">
          <a href="https://twitter.com/CloudWorksst" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="qf-footer__social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/quantumfram" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="qf-footer__social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
          </a>
          <a href="https://wa.me/15551234567" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="qf-footer__social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
          <a href="https://www.instagram.com/CloudWorksstudio" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="qf-footer__social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        </div>
      </div>

      <div class="qf-footer__col">
        <h3 class="qf-footer__heading">Quick Links</h3>
        <ul class="qf-footer__list">
          {quickLinks.map((link) => (
            <li><a href={link.href} class="qf-footer__link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="qf-footer__col">
        <h3 class="qf-footer__heading">Our Services</h3>
        <ul class="qf-footer__list">
          {services.map((service) => (
            <li><a href="/services" class="qf-footer__link">{service}</a></li>
          ))}
        </ul>
      </div>

      <div class="qf-footer__col">
        <h3 class="qf-footer__heading">Get in Touch</h3>
        <ul class="qf-footer__list qf-footer__contact-list">
          <li class="qf-footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href="mailto:info@CloudWorksstudio.com" class="qf-footer__link">info@CloudWorksstudio.com</a>
          </li>
          <li class="qf-footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <a href="tel:+15551234567" class="qf-footer__link">+91 924 301 5433</a>
          </li>
          <li class="qf-footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="qf-footer__link">Tech City, Global</span>
          </li>
        </ul>
        <p class="qf-footer__locations-label">Serving:</p>
        <div class="qf-footer__locations">
          {locations.map((loc) => (
            <span class="qf-footer__location-tag">{loc}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="qf-footer__bottom">
      <p class="qf-footer__copyright">
        &copy; {currentYear} CloudWorks Agency. All rights reserved.
      </p>
      <div class="qf-footer__bottom-links">
        <a href="/contact" class="qf-footer__bottom-link">Privacy Policy</a>
        <a href="/contact" class="qf-footer__bottom-link">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .qf-footer {
    position: relative;
    background: var(--qf-primary);
    border-top: 1px solid var(--qf-border);
    overflow: hidden;
  }

  .qf-footer__glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(108,99,255,0.08), transparent 70%);
    pointer-events: none;
  }

  .qf-footer__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: var(--qf-space-3xl);
    padding-block: var(--qf-space-4xl);
  }

  .qf-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--qf-space-lg);
  }

  .qf-footer__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .qf-footer__logo-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--qf-gradient);
    border-radius: var(--qf-radius-sm);
    font-family: var(--qf-font-heading);
    font-weight: 900;
    font-size: 1.1rem;
    color: white;
  }

  .qf-footer__logo-text {
    font-family: var(--qf-font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--qf-white);
  }

  .qf-footer__logo-accent {
    background: var(--qf-gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .qf-footer__tagline {
    font-size: 0.9rem;
    color: var(--qf-muted);
    line-height: 1.8;
    max-width: 320px;
  }

  .qf-footer__social {
    display: flex;
    gap: 0.75rem;
  }

  .qf-footer__social-link {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--qf-radius-sm);
    border: 1px solid var(--qf-border);
    color: var(--qf-muted);
    transition: all var(--qf-duration) var(--qf-ease);
  }

  .qf-footer__social-link:hover {
    color: var(--qf-accent);
    border-color: var(--qf-accent);
    background: rgba(108, 99, 255, 0.1);
    transform: translateY(-2px);
  }

  .qf-footer__heading {
    font-family: var(--qf-font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--qf-white);
    margin-bottom: var(--qf-space-lg);
    letter-spacing: 0.02em;
  }

  .qf-footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .qf-footer__link {
    font-size: 0.875rem;
    color: var(--qf-muted);
    transition: color var(--qf-duration) var(--qf-ease);
  }

  .qf-footer__link:hover {
    color: var(--qf-accent);
  }

  .qf-footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--qf-muted);
  }

  .qf-footer__contact-item svg {
    margin-top: 2px;
    flex-shrink: 0;
  }

  .qf-footer__locations-label {
    font-size: 0.8rem;
    color: var(--qf-muted);
    margin-top: var(--qf-space-lg);
    margin-bottom: var(--qf-space-sm);
  }

  .qf-footer__locations {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .qf-footer__location-tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: rgba(108, 99, 255, 0.1);
    border: 1px solid var(--qf-border);
    border-radius: var(--qf-radius-full);
    color: var(--qf-muted);
  }

  .qf-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--qf-space-xl);
    border-top: 1px solid var(--qf-border);
  }

  .qf-footer__copyright {
    font-size: 0.8rem;
    color: var(--qf-muted);
  }

  .qf-footer__bottom-links {
    display: flex;
    gap: var(--qf-space-lg);
  }

  .qf-footer__bottom-link {
    font-size: 0.8rem;
    color: var(--qf-muted);
    transition: color var(--qf-duration) var(--qf-ease);
  }

  .qf-footer__bottom-link:hover {
    color: var(--qf-accent);
  }

  @media (max-width: 1024px) {
    .qf-footer__top {
      grid-template-columns: 1fr 1fr;
      gap: var(--qf-space-2xl);
    }
  }

  @media (max-width: 640px) {
    .qf-footer__top {
      grid-template-columns: 1fr;
      gap: var(--qf-space-2xl);
    }

    .qf-footer__bottom {
      flex-direction: column;
      gap: var(--qf-space-md);
      text-align: center;
    }
  }
</style>
