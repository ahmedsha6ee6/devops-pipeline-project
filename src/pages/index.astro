  <!-- ===== STATS ===== -->
  <section class="hp-stats" id="hp-stats">
    <div class="qf-container">
      <div class="hp-stats__grid">
        <div class="hp-stats__item qf-reveal">
          <span class="hp-stats__number qf-gradient-text" data-target="900">0</span>
          <span class="hp-stats__suffix qf-gradient-text">%</span>
          <span class="hp-stats__label">Traffic Growth</span>
        </div>
        <div class="hp-stats__item qf-reveal">
          <span class="hp-stats__number qf-gradient-text" data-target="425">0</span>
          <span class="hp-stats__suffix qf-gradient-text">%</span>
          <span class="hp-stats__label">Conversion Increase</span>
        </div>
        <div class="hp-stats__item qf-reveal">
          <span class="hp-stats__number qf-gradient-text" data-target="50">0</span>
          <span class="hp-stats__suffix qf-gradient-text">+</span>
          <span class="hp-stats__label">Projects Delivered</span>
        </div>
        <div class="hp-stats__item qf-reveal">
          <span class="hp-stats__number qf-gradient-text" data-target="5">0</span>
          <span class="hp-stats__suffix qf-gradient-text">+</span>
          <span class="hp-stats__label">Years Experience</span>
