---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RocketCursor from '../components/RocketCursor.astro';
import '../styles/global.css';
---

<BaseLayout
  title="CloudWorks Agency | Leading Web Development & Digital Marketing Agency in Tech City"
  description="CloudWorks Agency - Tech City's premier web development and digital marketing agency. Expert website design, SEO services, social media marketing, AI video creation, e-commerce development. Proven results: 900% traffic growth, 425% conversion increases. Serving Global locations."
>
  <RocketCursor slot="cursor" />
  <Navbar slot="navbar" />

  <!-- ===== HERO ===== -->
  <section class="hp-hero" id="hp-hero">
    <div class="hp-hero__particles" aria-hidden="true">
      <span class="hp-hero__particle"></span><span class="hp-hero__particle"></span>
      <span class="hp-hero__particle"></span><span class="hp-hero__particle"></span>
      <span class="hp-hero__particle"></span><span class="hp-hero__particle"></span>
      <span class="hp-hero__particle"></span><span class="hp-hero__particle"></span>
      <span class="hp-hero__particle"></span><span class="hp-hero__particle"></span>
      <span class="hp-hero__particle"></span><span class="hp-hero__particle"></span>
    </div>
    <div class="hp-hero__glow" aria-hidden="true"></div>
    <div class="qf-container hp-hero__content">
      <span class="qf-section-label">Welcome to CloudWorks Agency</span>
      <h1 class="hp-hero__title">We Build<br/><span class="qf-gradient-text">Digital Empires</span></h1>
      <p class="hp-hero__subtitle">Transform Your Business with Cutting-Edge Web Development &amp; Digital Marketing</p>
      <div class="hp-hero__typing">
        <span class="hp-hero__typing-text"></span>
        <span class="hp-hero__typing-cursor">|</span>
      </div>
      <div class="hp-hero__cta">
        <a href="/contact" class="qf-btn qf-btn--primary">Start Your Project
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/portfolio" class="qf-btn qf-btn--outline">View Our Work</a>
      </div>
    </div>
    <div class="hp-hero__scroll" aria-hidden="true">
      <span class="hp-hero__scroll-text">Scroll</span>
      <div class="hp-hero__scroll-line"></div>
    </div>
  </section>

  <!-- ===== SERVICES ===== -->
  <section class="qf-section hp-services" id="hp-services">
    <div class="qf-container">
      <div class="hp-services__header qf-reveal">
        <span class="qf-section-label">What We Do</span>
        <h2 class="qf-section-title">Comprehensive Digital Solutions</h2>
        <p class="qf-section-subtitle">End-to-end digital services designed to accelerate your business growth.</p>
      </div>
      <div class="hp-services__grid">
