        </div>
        <div class="hp-services__card qf-glass-card qf-reveal">
          <div class="hp-services__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent2)" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
