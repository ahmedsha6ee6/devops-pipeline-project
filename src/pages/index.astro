    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section class="qf-section hp-process" id="hp-process">
    <div class="qf-container">
      <div class="hp-process__header qf-reveal">
        <span class="qf-section-label">How We Work</span>
        <h2 class="qf-section-title">Our Proven Process</h2>
        <p class="qf-section-subtitle">A streamlined workflow that delivers exceptional results, every time.</p>
      </div>
      <div class="hp-process__timeline">
        <div class="hp-process__line" aria-hidden="true"></div>
        <div class="hp-process__step qf-reveal">
          <div class="hp-process__step-num">01</div>
          <div class="hp-process__step-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent)" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </div>
          <h3 class="hp-process__step-title">Discovery</h3>
          <p class="hp-process__step-desc">We deep-dive into your business, goals, audience, and competitive landscape.</p>
        </div>
        <div class="hp-process__step qf-reveal">
          <div class="hp-process__step-num">02</div>
          <div class="hp-process__step-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent2)" stroke-width="1.5"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
          </div>
