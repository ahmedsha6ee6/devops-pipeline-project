          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent)" stroke-width="1.5"><path d="M3 21h18M9 8h1M9 12h1M9 16h1M14 8h1M14 12h1M14 16h1M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16"/></svg>
          <h3>Real Estate</h3>
          <p>Property platforms, virtual tours, and lead generation systems.</p>
        </div>
        <div class="hp-industries__card qf-glass-card qf-reveal">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent2)" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
          <h3>E-Commerce</h3>
          <p>High-converting online stores with seamless checkout experiences.</p>
        </div>
        <div class="hp-industries__card qf-glass-card qf-reveal">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent)" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          <h3>Healthcare</h3>
          <p>Patient portals, telemedicine platforms, and medical practice websites.</p>
        </div>
        <div class="hp-industries__card qf-glass-card qf-reveal">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent2)" stroke-width="1.5"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
          <h3>Education</h3>
          <p>E-learning platforms, school websites, and educational portals.</p>
        </div>
        <div class="hp-industries__card qf-glass-card qf-reveal">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent)" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          <h3>Hospitality</h3>
          <p>Restaurant websites, hotel booking systems, and tourism platforms.</p>
        </div>
        <div class="hp-industries__card qf-glass-card qf-reveal">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent2)" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <h3>Startups</h3>
          <p>MVP development, brand identity, and growth marketing for new ventures.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="hp-cta" id="hp-cta">
    <div class="hp-cta__glow" aria-hidden="true"></div>
    <div class="qf-container hp-cta__content qf-reveal">
      <h2 class="hp-cta__title">Ready to Transform Your<br/><span class="qf-gradient-text">Digital Presence?</span></h2>
      <p class="hp-cta__subtitle">Let us help you build something extraordinary. Get a free consultation today.</p>
      <a href="/contact" class="qf-btn qf-btn--primary hp-cta__btn">Get Free Consultation
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<!-- Counter Animation -->
<script>
  const counters = document.querySelectorAll('.hp-stats__number[data-target]');
  let animated = false;

  const statsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !animated) {
        animated = true;
        counters.forEach(counter => {
          const target = parseInt(counter.getAttribute('data-target') || '0');
          const duration = 2000;
          const start = performance.now();

          function updateCounter(now: number) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            counter.textContent = Math.floor(eased * target).toString();
            if (progress < 1) requestAnimationFrame(updateCounter);
          }
          requestAnimationFrame(updateCounter);
        });
      }
    });
  }, { threshold: 0.3 });

  const statsSection = document.getElementById('hp-stats');
  if (statsSection) statsObserver.observe(statsSection);
</script>

<!-- Typing Animation -->
<script>
  const words = ['For Startups', 'For Enterprises', 'For E-Commerce', 'For Every Business'];
  const typingEl = document.querySelector('.hp-hero__typing-text');
  let wordIndex = 0;
  let charIndex = 0;
  let deleting = false;

  function typeEffect() {
    if (!typingEl) return;
    const currentWord = words[wordIndex];

    if (!deleting) {
      typingEl.textContent = currentWord.substring(0, charIndex + 1);
      charIndex++;
      if (charIndex === currentWord.length) {
        deleting = true;
        setTimeout(typeEffect, 1800);
        return;
      }
      setTimeout(typeEffect, 80);
    } else {
      typingEl.textContent = currentWord.substring(0, charIndex - 1);
      charIndex--;
      if (charIndex === 0) {
        deleting = false;
        wordIndex = (wordIndex + 1) % words.length;
      }
      setTimeout(typeEffect, 40);
    }
  }

  setTimeout(typeEffect, 1000);
</script>

<style>
  /* ===== HERO ===== */
  .hp-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--qf-surface);
    background-image: var(--qf-gradient-mesh);
  }

  .hp-hero__glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(108,99,255,0.12), transparent 70%);
    pointer-events: none;
  }

  .hp-hero__particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hp-hero__particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: rgba(108,99,255,0.5);
    border-radius: 50%;
    animation: hp-float linear infinite;
  }

  .hp-hero__particle:nth-child(1) { left:10%; animation-duration:8s; animation-delay:0s; }
  .hp-hero__particle:nth-child(2) { left:20%; animation-duration:10s; animation-delay:1s; width:2px; height:2px; background:rgba(0,212,170,0.4); }
  .hp-hero__particle:nth-child(3) { left:30%; animation-duration:7s; animation-delay:2s; }
  .hp-hero__particle:nth-child(4) { left:40%; animation-duration:9s; animation-delay:0.5s; width:4px; height:4px; }
  .hp-hero__particle:nth-child(5) { left:55%; animation-duration:11s; animation-delay:1.5s; background:rgba(0,212,170,0.4); }
  .hp-hero__particle:nth-child(6) { left:65%; animation-duration:8s; animation-delay:3s; width:2px; height:2px; }
  .hp-hero__particle:nth-child(7) { left:75%; animation-duration:10s; animation-delay:2.5s; }
  .hp-hero__particle:nth-child(8) { left:85%; animation-duration:7s; animation-delay:0s; background:rgba(0,212,170,0.4); }
  .hp-hero__particle:nth-child(9) { left:15%; animation-duration:9s; animation-delay:4s; width:2px; height:2px; }
  .hp-hero__particle:nth-child(10) { left:50%; animation-duration:12s; animation-delay:2s; }
  .hp-hero__particle:nth-child(11) { left:70%; animation-duration:6s; animation-delay:1s; background:rgba(0,212,170,0.3); width:2px; height:2px; }
  .hp-hero__particle:nth-child(12) { left:90%; animation-duration:10s; animation-delay:3.5s; }

  @keyframes hp-float {
    0% { transform: translateY(100vh) scale(0); opacity:0; }
    10% { opacity:1; }
    90% { opacity:1; }
    100% { transform: translateY(-10vh) scale(1); opacity:0; }
  }

  .hp-hero__content {
    text-align: center;
    position: relative;
    z-index: 2;
    padding-top: 6rem;
  }

  .hp-hero__title {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 900;
    color: var(--qf-white);
    line-height: 1.05;
    margin-bottom: var(--qf-space-lg);
    letter-spacing: -0.03em;
  }

  .hp-hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.3rem);
    color: var(--qf-muted);
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--qf-space-lg);
    line-height: 1.7;
  }

  .hp-hero__typing {
    font-family: var(--qf-font-heading);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 600;
    color: var(--qf-accent);
    margin-bottom: var(--qf-space-2xl);
    min-height: 2rem;
  }

  .hp-hero__typing-cursor {
    animation: hp-blink 0.7s infinite;
    color: var(--qf-accent2);
  }

  @keyframes hp-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hp-hero__cta {
    display: flex;
    gap: var(--qf-space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .hp-hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hp-hero__scroll-text {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--qf-muted);
  }

  .hp-hero__scroll-line {
    width: 1px;
    height: 40px;
    background: var(--qf-gradient);
    animation: hp-scroll-bounce 2s infinite;
  }

  @keyframes hp-scroll-bounce {
    0%, 100% { transform: scaleY(0.4); transform-origin: top; opacity:0.3; }
    50% { transform: scaleY(1); opacity:1; }
  }

  /* ===== SERVICES ===== */
  .hp-services__header {
    text-align: center;
    margin-bottom: var(--qf-space-3xl);
  }

  .hp-services__header .qf-section-label { justify-content: center; }
  .hp-services__header .qf-section-subtitle { margin-inline: auto; }

  .hp-services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--qf-space-xl);
  }

  .hp-services__card {
    padding: var(--qf-space-2xl);
    position: relative;
    overflow: hidden;
  }

  .hp-services__card--new {
    border-color: rgba(0, 212, 170, 0.3);
  }

  .hp-services__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.2rem 0.7rem;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    background: var(--qf-gradient);
    border-radius: var(--qf-radius-full);
    color: white;
  }

  .hp-services__icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(108,99,255,0.08);
    border-radius: var(--qf-radius-md);
    margin-bottom: var(--qf-space-lg);
