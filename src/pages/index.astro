            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent)" stroke-width="1.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/></svg>
          </div>
          <h3 class="hp-process__step-title">Development</h3>
          <p class="hp-process__step-desc">Building robust, scalable, and high-performance solutions with clean code.</p>
        </div>
        <div class="hp-process__step qf-reveal">
          <div class="hp-process__step-num">04</div>
          <div class="hp-process__step-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--qf-accent2)" stroke-width="1.5"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 00-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 012-3.95A12.88 12.88 0 0122 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 01-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
          </div>
